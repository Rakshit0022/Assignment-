
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TravelEase - Responsive Landing Page</title>

    <style>
        /* Basic Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            color: #12203a;
            background: #eef2f8;
        }

        /* 9.1 Mobile First Design */
        .navbar {
            background: #12203a;
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 12px;
            gap: 8px;
        }

        .logo {
            font-size: 20px;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            gap: 15px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 13px;
        }

        /* Hero Section */
        .hero {
            background: #315bea;
            color: white;
            text-align: center;
            padding: 25px 15px;
            display: grid;
            gap: 15px;
            justify-items: center;
        }

        .hero h1 {
            font-size: 1.5rem;
        }

        .hero p {
            font-size: 0.85rem;
        }

        /* 9.2 Responsive Image */
        .hero img {
            width: 100%;
            max-width: 400px;
            height: auto;
            border-radius: 10px;
            display: block;
        }

        .image-placeholder {
            width: 100%;
            max-width: 400px;
            min-height: 150px;
            background: #a9bdf5;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #12203a;
            font-size: 14px;
        }

        /* 9.3 Features using CSS Grid */
        .features {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
            padding: 15px;
            background: white;
        }

        .feature {
            background: #eef2ff;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
        }

        .feature h3 {
            font-size: 1rem;
            margin-bottom: 5px;
        }

        .feature p {
            font-size: 0.85rem;
        }

        /* Footer */
        footer {
            background: #12203a;
            color: white;
            text-align: center;
            padding: 15px;
            font-size: 0.85rem;
        }

        /* Tablet Layout - 768px */
        @media (min-width: 768px) {
            .navbar {
                flex-direction: row;
                justify-content: space-between;
                padding: 15px 25px;
            }

            .hero {
                padding: 35px;
            }

            .hero h1 {
                font-size: 2rem;
            }

            .features {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        /* Desktop Layout - 1024px */
        @media (min-width: 1024px) {
            .navbar {
                padding: 15px 40px;
            }

            .hero {
                min-height: 300px;
            }

            .hero h1 {
                font-size: 2.2rem;
            }

            .hero .image-placeholder {
                max-width: 500px;
                min-height: 180px;
            }

            .features {
                padding: 25px;
                grid-template-columns: repeat(3, 1fr);
            }
        }

    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <nav class="navbar">
        <div class="logo">TravelEase</div>

        <div class="nav-links">
            <a href="#home">Home</a>
            <a href="#trips">Trips</a>
            <a href="#contact">Contact</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero" id="home">

        <div>
            <h1>Plan your next trip in minutes</h1>
            <p>Simple, cheap and fun travel plans.</p>
        </div>

        <!-- Image Placeholder -->
        <div class="image-placeholder">
            img/hero.jpg
        </div>

    </section>

    <!-- Features Section -->
    <section class="features" id="trips">

        <div class="feature">
            <h3>Easy Booking</h3>
            <p>Book in 3 clicks.</p>
        </div>

        <div class="feature">
            <h3>Best Prices</h3>
            <p>We compare for you.</p>
        </div>

        <div class="feature">
            <h3>24x7 Help</h3>
            <p>We are always here.</p>
        </div>

    </section>

    <!-- Footer -->
    <footer id="contact">
        <p>© 2026 TravelEase. All Rights Reserved.</p>
    </footer>

</body>
</html>
