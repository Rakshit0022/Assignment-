
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Landing Page Header</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f0f4f8;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #172554;
            color: white;
            padding: 20px 8%;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        nav {
            display: flex;
            gap: 25px;
        }

        nav a {
            color: white;
            text-decoration: none;
        }

        nav a:hover {
            color: #facc15;
        }

        .btn {
            background: #facc15;
            color: #172554;
            padding: 10px 18px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
        }

        .hero {
            text-align: center;
            padding: 100px 20px;
        }

        .hero h1 {
            font-size: 40px;
            margin-bottom: 20px;
        }

        .hero p {
            margin-bottom: 25px;
            color: #555;
        }

        @media (max-width: 600px) {
            header {
                flex-direction: column;
                gap: 20px;
            }

            nav {
                flex-wrap: wrap;
                justify-content: center;
                gap: 15px;
            }

            .hero h1 {
                font-size: 30px;
            }
        }
    </style>
</head>

<body>

<header>
    <div class="logo">MyWebsite</div>

    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
    </nav>

    <a href="#contact" class="btn">Login</a>
</header>

<main class="hero" id="home">
    <h1>Welcome to My Website</h1>
    <p>Learn, Create and Build Your Future with Us.</p>
    <a href="#about" class="btn">Get Started</a>
</main>

</body>
</html>
