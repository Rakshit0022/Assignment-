
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coding Club</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* 5.4 CSS Variables */
        :root {
            --brand: #2f5bea;
            --light: #eef2ff;
            --white: #ffffff;
            --dark: #1e293b;
            --text: #475569;
            --spacing: 20px;
        }

        /* 5.2 Universal Selector */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Body Styling */
        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--light);
            color: var(--text);
            line-height: 1.6;
            padding: var(--spacing);
        }

        /* 5.2 Element Selector */
        h1 {
            color: var(--white);
            font-size: 32px;
        }

        h2 {
            color: var(--dark);
            font-size: 22px;
            margin-bottom: 12px;
        }

        /* 5.2 ID Selector */
        #hero {
            background-color: var(--brand);
            color: var(--white);
            text-align: center;
            padding: 35px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        #hero p {
            color: var(--white);
        }

        /* 5.2 Class Selector */
        .container {
            max-width: 800px;
            margin: auto;
        }

        .card {
            background-color: var(--white);
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.05);
        }

        /* Events Table */
        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background-color: var(--brand);
            color: var(--white);
            text-align: left;
        }

        th, td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

        /* Registration Form */
        form {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        label {
            font-weight: 500;
        }

        input, select, textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #bbb;
            border-radius: 5px;
            font-family: inherit;
        }

        button {
            background-color: var(--brand);
            color: var(--white);
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 15px;
        }

        button:hover {
            background-color: #1d43bd;
        }

        /* 5.5 Responsive Design */
        @media (max-width: 600px) {
            body {
                padding: 10px;
            }

            #hero {
                padding: 25px 10px;
            }

            h1 {
                font-size: 25px;
            }

            .card {
                padding: 15px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <!-- Hero Section -->
    <header id="hero">
        <h1>Coding Club</h1>
        <p>Learn. Build. Share.</p>
    </header>

    <!-- Upcoming Events -->
    <section class="card">
        <h2>Upcoming Events</h2>

        <table>
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Venue</th>
            </tr>

            <tr>
                <td>HTML Workshop</td>
                <td>12 Nov</td>
                <td>Lab 1</td>
            </tr>

            <tr>
                <td>Hackathon</td>
                <td>20 Nov</td>
                <td>Seminar Hall</td>
            </tr>
        </table>
    </section>

    <!-- Registration Form -->
    <section class="card">
        <h2>Register</h2>

        <form>
            <label for="name">Name:</label>
            <input type="text" id="name" placeholder="Your name" required>

            <label for="email">Email:</label>
            <input type="email" id="email" placeholder="you@example.com" required>

            <label for="course">Course:</label>
            <select id="course">
                <option>Select Course</option>
                <option>B.Tech</option>
                <option>BCA</option>
                <option>MCA</option>
            </select>

            <label for="msg">Why do you want to join?</label>
            <textarea id="msg" rows="3" placeholder="Write your reason..."></textarea>

            <button type="submit">Register</button>
        </form>
    </section>

</div>

</body>
</html>
