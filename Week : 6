
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile Page</title>

    <style>
        /* 6.1 Box Model */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #eef2f8;
            padding-bottom: 80px;
        }

        /* 6.4 Sticky Top Bar */
        header {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #17243d;
            color: white;
            text-align: center;
            padding: 12px;
        }

        /* Main Container */
        .profile-container {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            gap: 25px;
            flex-wrap: wrap;
            padding: 30px;
        }

        /* 6.2 Profile Card */
        .profile-card {
            width: 230px;
            padding: 12px;
            border: 2px solid #5878d8;
            border-radius: 12px;
            background: white;
            text-align: center;
            margin: 5px;
        }

        /* Second Colour Version */
        .profile-card.green {
            border-color: #16a085;
            background: #f0fff8;
        }

        /* Round Avatar */
        .avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #315ce5;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
            margin: 0 auto 12px;
        }

        .green .avatar {
            background: #16a085;
        }

        .profile-card h2 {
            font-size: 18px;
            margin-bottom: 8px;
        }

        .role {
            font-size: 13px;
            margin-bottom: 12px;
        }

        /* 6.3 Scrollable Bio Box */
        .bio {
            height: 75px;
            overflow: auto;
            border: 1px solid #ccc;
            padding: 5px;
            font-size: 12px;
            text-align: left;
        }

        /* 6.4 Fixed Floating Button */
        .add-btn {
            position: fixed;
            bottom: 25px;
            right: 25px;
            width: 45px;
            height: 45px;
            border: none;
            border-radius: 50%;
            background: #ffb900;
            color: black;
            font-size: 25px;
            cursor: pointer;
            z-index: 20;
        }

        .add-btn:hover {
            background: #e5a600;
        }

        /* 6.5 Clean Layout */
        @media (max-width: 500px) {
            .profile-container {
                padding: 20px 10px;
            }
        }
    </style>
</head>

<body>

    <!-- Sticky Header -->
    <header>
        My Profile Page
    </header>

    <!-- Profile Cards -->
    <main class="profile-container">

        <!-- Blue Profile Card -->
        <div class="profile-card">
            <div class="avatar">R</div>

            <h2>Rakshit</h2>

            <p class="role">Web Developer in Making</p>

            <div class="bio">
                Hi! I am Rakshit. I started coding this year.
                I like making small websites, drawing and
                listening to music. My goal is to build my
                own app. This is my personal profile page.
            </div>
        </div>

        <!-- Green Profile Card -->
        <div class="profile-card green">
            <div class="avatar">A</div>

            <h2>Aman Sharma</h2>

            <p class="role">Frontend Developer</p>

            <div class="bio">
                Hello! I am Aman. I love HTML, CSS and
                JavaScript. I enjoy creating websites and
                learning new technologies. My dream is to
                become a professional software developer.
            </div>
        </div>

    </main>

    <!-- Fixed Add Button -->
    <button class="add-btn" onclick="alert('Add New Profile!')">
        +
    </button>

</body>
</html>
