
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CodeLab</title>

<style>

/* Basic Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    color: #12203a;
}

/* 7.1 Navbar: Logo Left, Links and Button Right */
nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 24px;
    background: #12203a;
    color: white;
}

.logo {
    font-size: 22px;
    font-weight: bold;
}

.nav-right {
    display: flex;
    align-items: center;
    gap: 25px;
}

.nav-right a {
    color: white;
    text-decoration: none;
    font-size: 14px;
}

.signup {
    background: #ffb900;
    color: black;
    border: none;
    padding: 9px 18px;
    border-radius: 6px;
    cursor: pointer;
}

/* 7.2 Center Banner Using Flexbox */
.hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: 250px;
    background: #315bea;
    color: white;
    padding: 20px;
}

.hero h1 {
    font-size: 30px;
    margin-bottom: 8px;
}

.hero p {
    font-size: 14px;
    margin-bottom: 15px;
}

.get-started {
    background: #ffb900;
    border: none;
    padding: 10px 18px;
    border-radius: 6px;
    cursor: pointer;
}

/* 7.3 Cards Using Flexbox */
.cards {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    padding: 15px;
    justify-content: center;
}

.card {
    flex: 1 1 120px;
    background: #eef2ff;
    padding: 20px;
    border-radius: 10px;
    text-align: center;
}

.card h3 {
    font-size: 16px;
    margin-bottom: 5px;
}

.card p {
    font-size: 13px;
}

/* 7.4 Navbar and Banner Together */
.page-header {
    width: 100%;
}

/* 7.5 Responsive Design */
@media (max-width: 600px) {
    nav {
        flex-wrap: wrap;
        gap: 15px;
    }

    .nav-right {
        gap: 12px;
        flex-wrap: wrap;
    }

    .hero h1 {
        font-size: 24px;
    }
}

@media (max-width: 400px) {
    nav {
        justify-content: center;
    }

    .logo {
        width: 100%;
        text-align: center;
    }

    .nav-right {
        justify-content: center;
    }

    .card {
        flex-basis: 100%;
    }
}

</style>
</head>

<body>

<!-- Navbar + Banner -->
<div class="page-header">

    <!-- Navigation Bar -->
    <nav>
        <div class="logo">CodeLab</div>

        <div class="nav-right">
            <a href="#home">Home</a>
            <a href="#courses">Courses</a>
            <a href="#contact">Contact</a>

            <button class="signup">Sign up</button>
        </div>
    </nav>

    <!-- Hero Banner -->
    <section class="hero" id="home">
        <h1>Learn Web Development</h1>
        <p>Start from zero. Build real projects.</p>
        <button class="get-started">Get started</button>
    </section>

</div>

<!-- Course Cards -->
<section class="cards" id="courses">

    <div class="card">
        <h3>HTML</h3>
        <p>Build the structure</p>
    </div>

    <div class="card">
        <h3>CSS</h3>
        <p>Make it beautiful</p>
    </div>

    <div class="card">
        <h3>JavaScript</h3>
        <p>Make it smart</p>
    </div>

    <div class="card">
        <h3>Git</h3>
        <p>Save your work</p>
    </div>

</section>

<!-- Footer -->
<footer id="contact" style="text-align:center; padding:20px;">
    © 2026 CodeLab
</footer>

</body>
</html>
