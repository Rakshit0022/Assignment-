
<!DOCTYPE html>
<html>
<head>
<title>Profile Card</title>

<style>
* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #eaf0f8;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
}

.card {
    width: 300px;
    padding: 25px;
    margin: 20px;
    background: white;
    border: 2px solid #ddd;
    border-radius: 15px;
    text-align: center;
    position: relative;
    box-shadow: 0 5px 15px #bbb;
}

.badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: green;
    color: white;
    padding: 5px 10px;
    border-radius: 10px;
    font-size: 12px;
}

.profile-img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 3px solid navy;
    object-fit: cover;
}

h2 {
    color: navy;
    margin-bottom: 5px;
}

p {
    color: #555;
    display: block;
}

.skills span {
    display: inline-block;
    background: #e0eaff;
    color: navy;
    padding: 7px;
    margin: 4px;
    border-radius: 5px;
}

button {
    background: navy;
    color: white;
    border: none;
    padding: 10px 20px;
    margin-top: 15px;
    cursor: pointer;
    border-radius: 5px;
}
</style>
</head>

<body>

<div class="card">
    <span class="badge">Student</span>

    <img class="profile-img"
         src="https://placehold.co/100x100"
         alt="Profile Photo">

    <h2>Rakshit Shankhdhar</h2>
    <p>B.Tech AI Student</p>

    <div class="skills">
        <span>HTML</span>
        <span>CSS</span>
        <span>Java</span>
    </div>

    <button>View Profile</button>
</div>

</body>
</html>
